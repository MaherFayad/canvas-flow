{
  "name": "@flowcanvas/sdk",
  "version": "0.1.0",
  "description": "Show your app in any state on the Flow Canvas. Tiny, zero dependencies, a no-op outside the canvas and in production.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": ["flow-canvas", "design", "states", "prototype", "devtools"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./next": "./src/next.ts",
    "./vue": "./src/vue.ts",
    "./msw": "./src/msw.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "production": { "import": "./dist/prod.js", "require": "./dist/prod.cjs" },
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js", "require": "./dist/react.cjs" },
      "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js", "require": "./dist/next.cjs" },
      "./vue": { "types": "./dist/vue.d.ts", "import": "./dist/vue.js", "require": "./dist/vue.cjs" },
      "./msw": { "types": "./dist/msw.d.ts", "import": "./dist/msw.js", "require": "./dist/msw.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "msw": ">=2",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "msw": { "optional": true },
    "react": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@flowcanvas/protocol": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
}
