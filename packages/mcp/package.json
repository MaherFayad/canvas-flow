{
  "name": "@flowcanvas/mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets Claude read and edit a Flow Canvas project.",
  "license": "MIT",
  "author": "Maher Fayad",
  "homepage": "https://github.com/MaherFayad/canvas-flow/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaherFayad/canvas-flow.git",
    "directory": "packages/mcp"
  },
  "bugs": { "url": "https://github.com/MaherFayad/canvas-flow/issues" },
  "keywords": ["mcp", "model-context-protocol", "claude", "flow-canvas", "flowcanvas", "design", "prototype", "devtools"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./link-protocol": {
      "source": "./src/link-protocol.ts",
      "types": "./dist/link-protocol.d.ts",
      "import": "./dist/link-protocol.js"
    }
  },
  "bin": {
    "flowcanvas-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@flowcanvas/config": "workspace:*",
    "@flowcanvas/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
