{
  "$schema": "https://flowcanvas.dev/schema/v1.json",
  "version": 1,
  "project": {
    "name": "Helka ceramics",
    "origin": "http://localhost:5173"
  },
  "devices": [
    {
      "id": "iphone-16-pro-max",
      "label": "iPhone 16 Pro Max",
      "w": 440,
      "h": 956,
      "dpr": 3,
      "chrome": "ios"
    },
    {
      "id": "desktop",
      "label": "Desktop",
      "w": 1440,
      "h": 900,
      "dpr": 2,
      "chrome": "none"
    }
  ],
  "sections": [
    {
      "id": "onboarding",
      "title": "Onboarding",
      "parent": null,
      "color": "grey",
      "layout": "row",
      "collapsed": false,
      "locked": false,
      "order": 0
    },
    {
      "id": "browse",
      "title": "Browse & save",
      "parent": null,
      "color": "grey",
      "layout": "row",
      "collapsed": false,
      "locked": false,
      "order": 1
    },
    {
      "id": "checkout",
      "title": "Checkout",
      "parent": null,
      "color": "grey",
      "layout": "row",
      "collapsed": false,
      "locked": false,
      "order": 2
    },
    {
      "id": "classes",
      "title": "Book a class",
      "parent": null,
      "color": "grey",
      "layout": "row",
      "collapsed": false,
      "locked": false,
      "order": 3
    }
  ],
  "screens": [
    {
      "id": "welcome",
      "title": "Welcome",
      "section": "onboarding",
      "path": "/",
      "states": [
        "default",
        "loading",
        "error"
      ]
    },
    {
      "id": "pick-interests",
      "title": "Pick interests",
      "section": "onboarding",
      "path": "/interests",
      "states": [
        "default",
        "partial",
        "loading",
        "error"
      ]
    },
    {
      "id": "catalog",
      "title": "Catalog",
      "section": "onboarding",
      "path": "/catalog",
      "states": [
        "default",
        "loading",
        "empty",
        "partial",
        "error"
      ]
    },
    {
      "id": "product",
      "title": "Product detail",
      "section": "browse",
      "path": "/product/canele-dinner-plate",
      "states": [
        "default",
        "saved",
        "loading",
        "partial",
        "error"
      ]
    },
    {
      "id": "wishlist",
      "title": "Wishlist",
      "section": "browse",
      "path": "/wishlist",
      "states": [
        "default",
        "loading",
        "empty",
        "partial",
        "error"
      ]
    },
    {
      "id": "bag",
      "title": "Bag",
      "section": "checkout",
      "path": "/bag",
      "states": [
        "default",
        "loading",
        "empty",
        "partial",
        "error"
      ]
    },
    {
      "id": "checkout",
      "title": "Checkout",
      "section": "checkout",
      "path": "/checkout",
      "states": [
        "default",
        "loading",
        "empty",
        "error"
      ]
    },
    {
      "id": "order-confirmed",
      "title": "Order confirmed",
      "section": "checkout",
      "path": "/order-confirmed",
      "states": [
        "success",
        "loading",
        "partial",
        "error"
      ]
    },
    {
      "id": "classes",
      "title": "Pottery classes",
      "section": "classes",
      "path": "/classes",
      "states": [
        "default",
        "loading",
        "empty",
        "partial",
        "error"
      ]
    },
    {
      "id": "class",
      "title": "Class",
      "section": "classes",
      "path": "/classes/tableware-course",
      "states": [
        "default",
        "loading",
        "partial",
        "error"
      ]
    },
    {
      "id": "book-seat",
      "title": "Book a seat",
      "section": "classes",
      "path": "/classes/tableware-course/book",
      "states": [
        "default",
        "loading",
        "error"
      ]
    },
    {
      "id": "seat-booked",
      "title": "Seat booked",
      "section": "classes",
      "path": "/classes/tableware-course/booked",
      "states": [
        "success",
        "loading",
        "error"
      ]
    }
  ],
  "edges": [
    {
      "id": "e-get-started",
      "from": {
        "screen": "welcome",
        "state": "default"
      },
      "to": {
        "screen": "pick-interests",
        "state": "default"
      },
      "trigger": {
        "label": "Get started",
        "gesture": "tap",
        "target": "[data-fc=\"get-started\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-continue",
      "from": {
        "screen": "pick-interests",
        "state": "default"
      },
      "to": {
        "screen": "catalog",
        "state": "default"
      },
      "trigger": {
        "label": "Continue",
        "gesture": "submit",
        "target": "[data-fc=\"interests-continue\"]"
      },
      "transition": {
        "type": "fade",
        "duration": 250,
        "easing": "ease-out"
      },
      "kind": "happy"
    },
    {
      "id": "e-product-card",
      "from": {
        "screen": "catalog",
        "state": "default"
      },
      "to": {
        "screen": "product",
        "state": "default"
      },
      "trigger": {
        "label": "Product card",
        "gesture": "tap",
        "target": "[data-fc=\"product-card\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-save",
      "from": {
        "screen": "product",
        "state": "default"
      },
      "to": {
        "screen": "product",
        "state": "saved"
      },
      "trigger": {
        "label": "Save",
        "gesture": "tap",
        "target": "[data-fc=\"save\"]"
      },
      "transition": {
        "type": "sheet-up",
        "duration": 320,
        "easing": "cubic-bezier(0.32, 0.72, 0, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-view-wishlist",
      "from": {
        "screen": "product",
        "state": "saved"
      },
      "to": {
        "screen": "wishlist",
        "state": "default"
      },
      "trigger": {
        "label": "View wishlist",
        "gesture": "tap",
        "target": "[data-fc=\"view-wishlist\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-checkout",
      "from": {
        "screen": "bag",
        "state": "default"
      },
      "to": {
        "screen": "checkout",
        "state": "default"
      },
      "trigger": {
        "label": "Checkout",
        "gesture": "tap",
        "target": "[data-fc=\"checkout\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-pay",
      "from": {
        "screen": "checkout",
        "state": "default"
      },
      "to": {
        "screen": "checkout",
        "state": "loading"
      },
      "trigger": {
        "label": "Pay",
        "gesture": "submit",
        "target": "[data-fc=\"pay\"]"
      },
      "transition": {
        "type": "none",
        "duration": 0,
        "easing": "linear"
      },
      "kind": "happy"
    },
    {
      "id": "e-payment-accepted",
      "from": {
        "screen": "checkout",
        "state": "loading"
      },
      "to": {
        "screen": "order-confirmed",
        "state": "success"
      },
      "trigger": {
        "label": "Payment accepted",
        "gesture": "auto-after-ms",
        "afterMs": 1200
      },
      "transition": {
        "type": "fade",
        "duration": 250,
        "easing": "ease-out"
      },
      "kind": "happy"
    },
    {
      "id": "e-pay-declined",
      "from": {
        "screen": "checkout",
        "state": "default"
      },
      "to": {
        "screen": "checkout",
        "state": "error"
      },
      "trigger": {
        "label": "Pay",
        "gesture": "submit",
        "target": "[data-fc=\"pay\"]",
        "hint": "Card 4000 0000 0000 0002 is declined"
      },
      "transition": {
        "type": "fade",
        "duration": 160,
        "easing": "ease-out"
      },
      "kind": "error"
    },
    {
      "id": "e-see-classes",
      "from": {
        "screen": "catalog",
        "state": "default"
      },
      "to": {
        "screen": "classes",
        "state": "default"
      },
      "trigger": {
        "label": "See the classes",
        "gesture": "tap",
        "target": "[data-fc=\"see-classes\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-class-card",
      "from": {
        "screen": "classes",
        "state": "default"
      },
      "to": {
        "screen": "class",
        "state": "default"
      },
      "trigger": {
        "label": "Class card",
        "gesture": "tap",
        "target": "[data-fc=\"class-card\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-book-seat",
      "from": {
        "screen": "class",
        "state": "default"
      },
      "to": {
        "screen": "book-seat",
        "state": "default"
      },
      "trigger": {
        "label": "Book a seat",
        "gesture": "tap",
        "target": "[data-fc=\"book-seat\"]"
      },
      "transition": {
        "type": "push",
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "kind": "happy"
    },
    {
      "id": "e-confirm-booking",
      "from": {
        "screen": "book-seat",
        "state": "default"
      },
      "to": {
        "screen": "book-seat",
        "state": "loading"
      },
      "trigger": {
        "label": "Confirm booking",
        "gesture": "submit",
        "target": "[data-fc=\"confirm-booking\"]"
      },
      "transition": {
        "type": "none",
        "duration": 0,
        "easing": "linear"
      },
      "kind": "happy"
    },
    {
      "id": "e-booking-confirmed",
      "from": {
        "screen": "book-seat",
        "state": "loading"
      },
      "to": {
        "screen": "seat-booked",
        "state": "success"
      },
      "trigger": {
        "label": "Booking confirmed",
        "gesture": "auto-after-ms",
        "afterMs": 1200
      },
      "transition": {
        "type": "fade",
        "duration": 250,
        "easing": "ease-out"
      },
      "kind": "happy"
    }
  ],
  "mocks": {
    "catalog:loading": [
      {
        "match": {
          "method": "GET",
          "url": "/api/products*"
        },
        "status": 200,
        "delay": "forever"
      }
    ],
    "catalog:empty": [
      {
        "match": {
          "method": "GET",
          "url": "/api/products*"
        },
        "status": 200,
        "body": {
          "items": []
        }
      }
    ],
    "catalog:partial": [
      {
        "match": {
          "method": "GET",
          "url": "/api/products*"
        },
        "status": 200,
        "body": {
          "items": [
            {
              "id": "tall-mug-periwinkle",
              "name": "Tall mug",
              "glaze": "periwinkle",
              "price": 45,
              "category": "cups",
              "shape": "mug",
              "color": "#8C9BC8",
              "backdrop": "#DEE1E8",
              "stock": 8,
              "size": "380 ml",
