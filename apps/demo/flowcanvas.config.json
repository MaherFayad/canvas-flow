            },
            {
              "id": "cappuccino-cup-butter",
              "name": "Cappuccino cup",
              "glaze": "butter yellow",
              "price": 27,
              "category": "cups",
              "shape": "cup",
              "color": "#EBD9A0",
              "backdrop": "#E4E0EE",
              "stock": 1,
              "size": "180 ml",
              "garnish": "pour",
              "blurb": "Wide enough for a proper foam top, small enough to hold in one hand. Butter-yellow glaze over speckled stoneware."
            },
            {
              "id": "serving-bowl-apricot",
              "name": "Serving bowl",
              "glaze": "apricot",
              "price": 58,
              "category": "bowls",
              "shape": "wide-bowl",
              "color": "#E59E4E",
              "backdrop": "#E3E1DD",
              "stock": 5,
              "size": "24 cm",
              "blurb": "A shallow bowl for salads and long dinners. The apricot glaze pools darker in the well and breaks to bare clay at the rim."
            },
            {
              "id": "side-plate-chantilly",
              "name": "Side plate",
              "glaze": "chantilly",
              "price": 24,
              "category": "plates",
              "shape": "plate",
              "color": "#F1EADB",
              "backdrop": "#E6E4E0",
              "stock": 14,
              "size": "19 cm",
              "garnish": "egg",
              "blurb": "A side plate for toast, cake or a soft-boiled egg. Chantilly is our warm, satin white."
            },
            {
              "id": "big-bowl-periwinkle",
              "name": "Big bowl",
              "glaze": "periwinkle",
              "price": 46,
              "category": "bowls",
              "shape": "bowl",
              "color": "#8C9BC8",
              "backdrop": "#E2E2E4",
              "stock": 6,
              "size": "18 cm",
              "blurb": "Deep enough for ramen or a big breakfast. Periwinkle outside, a paler wash inside."
            },
            {
              "id": "canele-dinner-plate",
              "name": "Canelé dinner plate",
              "glaze": "chantilly",
              "price": 36,
              "category": "plates",
              "shape": "plate",
              "color": "#EFE7D6",
              "backdrop": "#DCDDE2",
              "stock": 9,
              "size": "27 cm",
              "blurb": "Our dinner plate with a fluted rim, pressed from a mould we carved after the little Bordeaux cakes. Satin chantilly glaze, dishwasher safe."
            }
          ],
          "unavailable": 6
        }
      }
    ],
    "catalog:error": [
      {
        "match": {
          "method": "GET",
          "url": "/api/products*"
        },
        "status": 500,
        "body": {
          "error": "server"
        }
      }
    ]
  },
  "tokens": {},
  "images": [],
  "notes": [],
  "comments": []
}
